<Window
    x:Class="Noxel.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:anim="using:Noxel.App.Animations"
    xmlns:ctl="using:Noxel.App.Controls"
    Title="NOXEL">

    <Grid x:Name="Root">
        <!-- Ambient "liquid glass" layer: a tint over the Mica backdrop plus two static soft glows. Nothing here animates. -->
        <Grid IsHitTestVisible="False">
            <Rectangle Fill="{ThemeResource NoxelWindowTint}" />
            <Ellipse Width="900" Height="700" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-320,-320,0,0" Opacity="0.18">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{ThemeResource NoxelGlowAColor}" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="900" Height="760" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-340,-360" Opacity="0.08">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{ThemeResource NoxelGlowBColor}" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <Grid x:Name="Shell">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom title bar (drag region). Caption buttons are drawn by Windows on the right (CaptionInset). -->
            <Grid x:Name="TitleBar" Height="48" Padding="16,0,0,0" Background="Transparent" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="CaptionInset" Width="140" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ctl:ShadowText Text="NOXEL" TextStyle="{StaticResource Wordmark}" VerticalAlignment="Center" />
                    <Border x:Name="VersionBadge" Style="{StaticResource Badge}">
                        <TextBlock x:Name="VersionText" Text="v1.0" Style="{StaticResource BadgeText}" FontFamily="{StaticResource NoxelMono}" />
                    </Border>
                </StackPanel>
                <StackPanel x:Name="TitleStatus" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{ThemeResource NoxelAccent}" Opacity="0.3" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="Loading…" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <NavigationView x:Name="Nav" Grid.Row="1"
                            PaneDisplayMode="Auto" OpenPaneLength="232" CompactPaneLength="56"
                            CompactModeThresholdWidth="700" ExpandedModeThresholdWidth="1100"
                            IsBackButtonVisible="Collapsed" IsSettingsVisible="True" IsTitleBarAutoPaddingEnabled="False"
                            SelectionChanged="OnNavSelectionChanged" ItemInvoked="OnNavItemInvoked" DisplayModeChanged="OnNavDisplayModeChanged">
                <NavigationView.Resources>
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                    <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
                </NavigationView.Resources>
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Dashboard" Tag="Dashboard" x:Name="NavDashboard">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Display" Tag="Display">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Color Studio" Tag="Color">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE790;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Presets" Tag="Presets">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <NavigationView.FooterMenuItems>
                    <NavigationViewItem Content="Compact view" Tag="Compact" SelectsOnInvoked="False" ToolTipService.ToolTip="Small always-available window">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE73F;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>

                <Grid x:Name="ContentHost">
                    <Frame x:Name="ContentFrame" CacheSize="5" Navigated="OnFrameNavigated" />
                    <Grid x:Name="MotionLayer" IsHitTestVisible="False" />
                    <ProgressRing x:Name="LoadingRing" IsActive="True" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </NavigationView>

            <!-- Notices -->
            <ctl:NotificationHost x:Name="NoticeHost" Grid.Row="1" Margin="16,0,20,20" />
        </Grid>

        <!-- Startup failure -->
        <Grid x:Name="FatalPanel" Visibility="Collapsed" Background="{ThemeResource NoxelWindowTint}">
            <Border Style="{StaticResource GlassCard}" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="NOXEL couldn't start" x:Name="PageHeading" Style="{StaticResource PageTitle}" FontSize="22" />
                    <TextBlock x:Name="FatalText" Style="{StaticResource BodyText}" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="FatalPath" Style="{StaticResource MutedText}" IsTextSelectionEnabled="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Open log folder" Click="OnOpenLogs" />
                        <Button Content="Exit" Style="{StaticResource NoxelPrimaryButton}" Click="OnFatalExit" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <anim:EyeSplash x:Name="Splash" Visibility="Collapsed" />
    </Grid>
</Window>
