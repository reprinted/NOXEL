<UserControl
    x:Class="Noxel.App.Animations.EyeSplash"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    AutomationProperties.Name="NOXEL intro animation. Press any key to skip.">
    <!-- "The Awakening": the N Eye forms from a line, its pupil wakes, the name appears, then it hands over to the app.
         All motion is composition animation; this XAML only lays the pieces out. Sizes are set in code. -->
    <Grid x:Name="Root" Background="#050508">
        <Grid x:Name="Backdrop" Background="#050508" />
        <!-- Curtain: plain XAML opacity, never touched by composition. It stays at 0 until the composition timeline is
             running, so no frame can show the pieces at their unanimated (fully visible) values. -->
        <Grid x:Name="Curtain" Opacity="0">
        <StackPanel x:Name="Stage" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Square host as wide as the mark's diagonal, so the rotated reveal never clips the artwork. -->
            <Grid x:Name="MarkHost">
                <Ellipse x:Name="Halo" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#55A688FF" Offset="0" />
                            <GradientStop Color="#18A688FF" Offset="0.45" />
                            <GradientStop Color="#00A688FF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!-- Rotated so its local horizontal is the eye's own axis (lower-left corner to upper-right corner). -->
                <Grid x:Name="AxisHost" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><RotateTransform x:Name="AxisRotate" /></Grid.RenderTransform>
                    <Grid x:Name="RevealHost">
                        <Image x:Name="Body" Source="ms-appx:///Assets/noxel-mark-body.png" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform><RotateTransform x:Name="BodyUnrotate" /></Image.RenderTransform>
                        </Image>
                    </Grid>
                    <Rectangle x:Name="Line" Height="2" VerticalAlignment="Center" IsHitTestVisible="False" RadiusX="1" RadiusY="1">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00CBB8FF" Offset="0" />
                                <GradientStop Color="#C8D6C8FF" Offset="0.3" />
                                <GradientStop Color="#F2EEE8FF" Offset="0.5" />
                                <GradientStop Color="#C8D6C8FF" Offset="0.7" />
                                <GradientStop Color="#00CBB8FF" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>
                <Image x:Name="Star" Source="ms-appx:///Assets/noxel-mark-star.png" Stretch="Uniform" IsHitTestVisible="False" />
            </Grid>
            <TextBlock x:Name="Wordmark" Text="NOXEL" HorizontalAlignment="Center" FontFamily="{StaticResource NoxelFontBrand}"
                       FontWeight="Bold" CharacterSpacing="420" Foreground="#ECE7FF" IsHitTestVisible="False" />
        </StackPanel>
        <TextBlock x:Name="SkipHint" Text="Click or press any key to skip" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,22" FontSize="11" Foreground="#6E6A86" CharacterSpacing="60" />
        </Grid>
    </Grid>
</UserControl>
