<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:anim="using:Noxel.App.Animations"
    xmlns:infra="using:Noxel.App.Infrastructure">

    <!--
        NOXEL design system. Brush instances in these theme dictionaries are mutated at runtime by
        ThemeService (accent colour, glass intensity), so every control using them updates instantly.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="NoxelActionFill" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="NoxelActionHover" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="NoxelActionPressed" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="NoxelActionText" Color="#F5F5F7" />
            <LinearGradientBrush x:Key="NoxelSpotlightFill" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#292337" Offset="0" />
                <GradientStop Color="#18181D" Offset="0.75" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="NoxelAccent" Color="#9B7BFF" />
            <SolidColorBrush x:Key="NoxelAccentSoft" Color="#339B7BFF" />
            <SolidColorBrush x:Key="NoxelAccentText" Color="#C6B4FF" />
            <SolidColorBrush x:Key="NoxelWindowTint" Color="#F00C0C0F" />
            <!-- Overlay navigation pane (compact rail opened / narrow flyout): opaque glass, never see-through. -->
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FF17171B" />
            <SolidColorBrush x:Key="NoxelGlassFill" Color="#D918181D" />
            <SolidColorBrush x:Key="NoxelGlassFillStrong" Color="#EF222228" />
            <SolidColorBrush x:Key="NoxelNoticeFill" Color="#FA24242B" />
            <SolidColorBrush x:Key="NoxelDialogBackground" Color="#FC202026" />
            <SolidColorBrush x:Key="NoxelDangerFill" Color="#B23A4C" />
            <SolidColorBrush x:Key="NoxelDangerFillHover" Color="#C14658" />
            <SolidColorBrush x:Key="NoxelDangerFillPressed" Color="#96303F" />
            <SolidColorBrush x:Key="NoxelGlassFillSubtle" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="NoxelGlassHover" Color="#17FFFFFF" />
            <LinearGradientBrush x:Key="NoxelGlassStroke" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#29FFFFFF" Offset="0" />
                <GradientStop Color="#1CFFFFFF" Offset="0.45" />
                <GradientStop Color="#14FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="NoxelGlassSheen" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0DFFFFFF" Offset="0" />
                <GradientStop Color="#00FFFFFF" Offset="0.35" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="NoxelDivider" Color="#1CFFFFFF" />
            <!-- Slider: the part after the thumb is neutral grey; the part before it is the accent (SliderTrackValueFill). -->
            <SolidColorBrush x:Key="SliderTrackFill" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#45FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#3DFFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="NoxelTextPrimary" Color="#F5F5F7" />
            <SolidColorBrush x:Key="NoxelTextSecondary" Color="#B5B5BF" />
            <SolidColorBrush x:Key="NoxelTextTertiary" Color="#92929F" />
            <SolidColorBrush x:Key="NoxelSuccess" Color="#7BE0A6" />
            <SolidColorBrush x:Key="NoxelWarning" Color="#F4C46B" />
            <SolidColorBrush x:Key="NoxelDanger" Color="#FF7A8A" />
            <SolidColorBrush x:Key="NoxelBadgeFill" Color="#1FFFFFFF" />
            <Color x:Key="NoxelGlowAColor">#7A55FF</Color>
            <Color x:Key="NoxelGlowBColor">#2C5BFF</Color>
            <Color x:Key="NoxelBaseColor">#0C0C0F</Color>

            <!-- Native dropdown palette: opaque popups stay legible above translucent cards. -->
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#242429" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#2E2E35" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#1D1D23" />
            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#242429" />
            <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#242429" />
            <AcrylicBrush x:Key="ComboBoxDropDownBackground" TintColor="#24242B" TintOpacity="0.75" FallbackColor="#24242B" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#45454F" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#45454F" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#45454F" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#45454F" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#F5F5F7" />
            <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#F5F5F7" />
            <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="#F5F5F7" />
            <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#B5B5BF" />
            <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="#F5F5F7" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#B5B5BF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#9B7BFF" />
            <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#F5F5F7" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#F5F5F7" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#F5F5F7" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedUnfocused" Color="#F5F5F7" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#F5F5F7" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#17FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#339B7BFF" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedUnfocused" Color="#339B7BFF" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#339B7BFF" />
            <SolidColorBrush x:Key="NoxelDangerText" Color="White" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="NoxelActionFill" Color="#0A2A1F60" />
            <SolidColorBrush x:Key="NoxelActionHover" Color="#18202024" />
            <SolidColorBrush x:Key="NoxelActionPressed" Color="#24202024" />
            <SolidColorBrush x:Key="NoxelActionText" Color="#202024" />
            <LinearGradientBrush x:Key="NoxelSpotlightFill" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#EEE8FF" Offset="0" />
                <GradientStop Color="#FFFFFF" Offset="0.75" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="NoxelAccent" Color="#6B4FD8" />
            <SolidColorBrush x:Key="NoxelAccentSoft" Color="#266B4FD8" />
            <SolidColorBrush x:Key="NoxelAccentText" Color="#5536C4" />
            <SolidColorBrush x:Key="NoxelWindowTint" Color="#F2F5F5F7" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FFFAFAFC" />
            <SolidColorBrush x:Key="NoxelGlassFill" Color="#B8FFFFFF" />
            <SolidColorBrush x:Key="NoxelGlassFillStrong" Color="#EBFFFFFF" />
            <SolidColorBrush x:Key="NoxelNoticeFill" Color="#FAFFFFFF" />
            <SolidColorBrush x:Key="NoxelDialogBackground" Color="#FCFFFFFF" />
            <SolidColorBrush x:Key="NoxelDangerFill" Color="#C93C4F" />
            <SolidColorBrush x:Key="NoxelDangerFillHover" Color="#D54A5C" />
            <SolidColorBrush x:Key="NoxelDangerFillPressed" Color="#AE3143" />
            <SolidColorBrush x:Key="NoxelGlassFillSubtle" Color="#0A2A1F60" />
            <SolidColorBrush x:Key="NoxelGlassHover" Color="#122A1F60" />
            <LinearGradientBrush x:Key="NoxelGlassStroke" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFFFFFFF" Offset="0" />
                <GradientStop Color="#24A5A5B2" Offset="0.5" />
                <GradientStop Color="#20A5A5B2" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="NoxelGlassSheen" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#66FFFFFF" Offset="0" />
                <GradientStop Color="#00FFFFFF" Offset="0.4" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="NoxelDivider" Color="#1A2A1F60" />
            <SolidColorBrush x:Key="SliderTrackFill" Color="#29000000" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#3D000000" />
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#33000000" />
            <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#14000000" />
            <SolidColorBrush x:Key="NoxelTextPrimary" Color="#202024" />
            <SolidColorBrush x:Key="NoxelTextSecondary" Color="#565660" />
            <SolidColorBrush x:Key="NoxelTextTertiary" Color="#6C6C78" />
            <SolidColorBrush x:Key="NoxelSuccess" Color="#1E8A55" />
            <SolidColorBrush x:Key="NoxelWarning" Color="#9A6200" />
            <SolidColorBrush x:Key="NoxelDanger" Color="#C42B3F" />
            <SolidColorBrush x:Key="NoxelBadgeFill" Color="#142A1F60" />
            <Color x:Key="NoxelGlowAColor">#C7B5FF</Color>
            <Color x:Key="NoxelGlowBColor">#B6D2FF</Color>
            <Color x:Key="NoxelBaseColor">#F5F5F7</Color>

            <!-- Native dropdown palette: opaque popups stay legible above translucent cards. -->
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#FDFDFE" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#F4F4F8" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#EBEBF0" />
            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#FDFDFE" />
            <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#FDFDFE" />
            <AcrylicBrush x:Key="ComboBoxDropDownBackground" TintColor="#FCFCFE" TintOpacity="0.75" FallbackColor="#FCFCFE" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#D7D7DF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#D7D7DF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#D7D7DF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#D7D7DF" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#202024" />
            <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#202024" />
            <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="#202024" />
            <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#565660" />
            <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="#202024" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#565660" />
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#6B4FD8" />
            <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#202024" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#202024" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#202024" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedUnfocused" Color="#202024" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#202024" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#122A1F60" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#266B4FD8" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedUnfocused" Color="#266B4FD8" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#266B4FD8" />
            <SolidColorBrush x:Key="NoxelDangerText" Color="White" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="NoxelActionFill" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NoxelActionHover" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NoxelActionPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NoxelActionText" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="NoxelSpotlightFill" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NoxelAccent" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NoxelAccentSoft" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NoxelAccentText" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NoxelWindowTint" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NoxelGlassFill" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NoxelGlassFillStrong" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NoxelNoticeFill" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NoxelDialogBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NoxelDangerFill" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NoxelDangerFillHover" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NoxelDangerFillPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NoxelGlassFillSubtle" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NoxelGlassHover" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NoxelGlassStroke" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NoxelGlassSheen" Color="Transparent" />
            <SolidColorBrush x:Key="NoxelDivider" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NoxelTextPrimary" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NoxelTextSecondary" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NoxelTextTertiary" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="NoxelSuccess" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NoxelWarning" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NoxelDanger" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NoxelBadgeFill" Color="{ThemeResource SystemColorWindowColor}" />
            <Color x:Key="NoxelGlowAColor">#00000000</Color>
            <Color x:Key="NoxelGlowBColor">#00000000</Color>
            <Color x:Key="NoxelBaseColor">#000000</Color>
            <SolidColorBrush x:Key="NoxelDangerText" Color="{ThemeResource SystemColorHighlightTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ============================== Typography ==============================
         Rajdhani (SIL OFL 1.1) for the wordmark; Inter (SIL OFL 1.1, variable) for
         headings, key values and controls. Bundled in Assets/Fonts with their licenses, so nothing has to be installed.
         Segoe UI Variable is the fallback. -->
    <FontFamily x:Key="NoxelFontBody">ms-appx:///Assets/Fonts/Inter-Variable.ttf#Inter, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="NoxelFontDisplay">ms-appx:///Assets/Fonts/Inter-Variable.ttf#Inter, Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="NoxelFontBrand">ms-appx:///Assets/Fonts/Rajdhani-Bold.ttf#Rajdhani, Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="NoxelMono">Cascadia Mono, Consolas</FontFamily>
    <!-- Stock WinUI controls read this key for their text. -->
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Inter-Variable.ttf#Inter, Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- ============================== Shape ==============================
         Every corner radius lives here. WinUI's own keys are overridden so stock controls follow. -->
    <CornerRadius x:Key="NoxelRadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="NoxelRadiusControl">10</CornerRadius>
    <CornerRadius x:Key="NoxelRadiusCard">20</CornerRadius>
    <CornerRadius x:Key="NoxelRadiusMajor">28</CornerRadius>
    <CornerRadius x:Key="NoxelRadiusDialog">24</CornerRadius>
    <CornerRadius x:Key="NoxelCardRadius">20</CornerRadius>
    <CornerRadius x:Key="NoxelControlRadius">10</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
    <!-- Stock item presenters read these resources instead of the container's CornerRadius. -->
    <CornerRadius x:Key="GridViewItemCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ListViewItemCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">16</CornerRadius>
    <!-- WinUI scales oversized elliptical corners; use half the standard 44-unit button height. -->
    <CornerRadius x:Key="NoxelRadiusPill">22</CornerRadius>
    <x:Double x:Key="NoxelCardSpacing">16</x:Double>

    <!-- Dropdown menus retain WinUI's native placement, chevron, focus ring and selection marker. -->
    <x:Double x:Key="ComboBoxMinHeight">44</x:Double>
    <CornerRadius x:Key="ComboBoxItemCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="ComboBoxHiglightBorderCornerRadius">6</CornerRadius>
    <Thickness x:Key="ComboBoxPadding">14,10,4,10</Thickness>
    <Thickness x:Key="ComboBoxItemThemePadding">10,6,10,6</Thickness>
    <Thickness x:Key="ComboBoxItemThemeTouchPadding">12,11,12,11</Thickness>
    <Thickness x:Key="ComboBoxDropdownBorderPadding">2,4,2,4</Thickness>

    <!-- ============================== Stock control adjustments ============================== -->
    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="infra:DropdownPresentation.BelowField" Value="True" />
        <Setter Property="FontFamily" Value="{StaticResource NoxelFontBody}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="CornerRadius" Value="{StaticResource NoxelRadiusControl}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MaxDropDownHeight" Value="420" />
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Must be based on DefaultCheckBoxStyle: an implicit style without BasedOn replaces WinUI's modern implicit
         style, and the control falls back to the legacy square 25-unit template that ignores CornerRadius.
         The 20-unit box gets a clearly rounded corner (7), in step with the 10-unit controls and 22-unit pills,
         but short of a circle so it never reads as a radio button. -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
        <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style x:Key="NoxelButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource NoxelFontBody}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="{StaticResource NoxelRadiusPill}" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Background" Value="{ThemeResource NoxelGlassFillSubtle}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NoxelDivider}" />
        <Setter Property="Foreground" Value="{ThemeResource NoxelTextPrimary}" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource NoxelButton}" />
    <!-- Based on the modern WinUI styles for the same reason as CheckBox above. -->
    <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="{StaticResource NoxelRadiusPill}" />
        <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
    </Style>
    <Style TargetType="ContentDialog">
        <Setter Property="CornerRadius" Value="{StaticResource NoxelRadiusDialog}" />
        <Setter Property="Background" Value="{ThemeResource NoxelDialogBackground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NoxelGlassStroke}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style TargetType="NavigationViewItem">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="{StaticResource NoxelRadiusControl}" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Margin" Value="0,2" />
    </Style>
    <Style TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Settings labels (control headers) are SemiBold; the values inside the controls stay Regular. -->
    <FontWeight x:Key="ComboBoxHeaderThemeFontWeight">SemiBold</FontWeight>
    <FontWeight x:Key="SliderHeaderThemeFontWeight">SemiBold</FontWeight>
    <Style TargetType="RadioButtons">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="NoxelPrimaryButton" TargetType="Button" BasedOn="{StaticResource NoxelButton}">
        <Setter Property="anim:Motion.HoverLift" Value="True" />
        <Setter Property="Background" Value="{ThemeResource NoxelActionFill}" />
        <Setter Property="Foreground" Value="{ThemeResource NoxelActionText}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource NoxelActionFill}" />
        <Setter Property="CornerRadius" Value="{StaticResource NoxelRadiusPill}" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" Background="{ThemeResource NoxelActionFill}" BorderBrush="{ThemeResource NoxelActionFill}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid.BackgroundTransition>
                            <BrushTransition Duration="0:0:0.12" />
                        </Grid.BackgroundTransition>
                        <ContentPresenter x:Name="ContentPresenter" Padding="{TemplateBinding Padding}" Foreground="{ThemeResource NoxelActionText}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters><Setter Target="RootGrid.Background" Value="{ThemeResource NoxelActionHover}" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters><Setter Target="RootGrid.Background" Value="{ThemeResource NoxelActionPressed}" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters><Setter Target="RootGrid.Opacity" Value="0.5" /></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dialog buttons: identical height, padding, radius and type; Cancel is neutral, destructive is red. -->
    <Style x:Key="NoxelDialogButton" TargetType="Button" BasedOn="{StaticResource NoxelButton}">
        <Setter Property="CornerRadius" Value="{StaticResource NoxelRadiusPill}" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="NoxelDialogAccentButton" TargetType="Button" BasedOn="{StaticResource NoxelPrimaryButton}">
        <Setter Property="CornerRadius" Value="{StaticResource NoxelRadiusPill}" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="NoxelDangerButton" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource NoxelDangerFill}" />
        <Setter Property="Foreground" Value="{ThemeResource NoxelDangerText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource NoxelRadiusPill}" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid.BackgroundTransition>
                            <BrushTransition Duration="0:0:0.12" />
                        </Grid.BackgroundTransition>
                        <ContentPresenter x:Name="ContentPresenter" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters><Setter Target="RootGrid.Background" Value="{ThemeResource NoxelDangerFillHover}" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters><Setter Target="RootGrid.Background" Value="{ThemeResource NoxelDangerFillPressed}" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters><Setter Target="RootGrid.Opacity" Value="0.5" /></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTipStyle}">
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style TargetType="InfoBar">
        <Setter Property="CornerRadius" Value="{StaticResource NoxelRadiusCard}" />
    </Style>

    <!-- ============================== Surfaces ============================== -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource NoxelGlassFill}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NoxelGlassStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource NoxelRadiusCard}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- One spotlight per page, reserved for the display summary or selected mode. -->
    <Style x:Key="SpotlightCard" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Setter Property="Background" Value="{ThemeResource NoxelSpotlightFill}" />
        <Setter Property="CornerRadius" Value="{StaticResource NoxelRadiusMajor}" />
    </Style>

    <Style x:Key="GlassInset" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource NoxelGlassFillSubtle}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NoxelDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource NoxelRadiusControl}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- ============================== Text styles ============================== -->
    <Style x:Key="Wordmark" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NoxelFontBrand}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="CharacterSpacing" Value="260" />
        <Setter Property="Foreground" Value="{ThemeResource NoxelTextPrimary}" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NoxelFontDisplay}" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource NoxelTextPrimary}" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NoxelFontBody}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource NoxelTextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NoxelFontDisplay}" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource NoxelTextPrimary}" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NoxelFontBody}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="110" />
        <Setter Property="Foreground" Value="{ThemeResource NoxelTextTertiary}" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NoxelFontBody}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource NoxelTextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DialogBodyText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="Foreground" Value="{ThemeResource NoxelTextSecondary}" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NoxelFontBody}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource NoxelTextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FaintText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NoxelFontBody}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource NoxelTextTertiary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NoxelFontDisplay}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{ThemeResource NoxelTextPrimary}" />
    </Style>

    <Style x:Key="StatValueMedium" TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
        <Setter Property="FontSize" Value="17" />
    </Style>
    <Style x:Key="StatValueSmall" TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="StatValueLarge" TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
        <Setter Property="FontSize" Value="28" />
    </Style>

    <Style x:Key="WordmarkLarge" TargetType="TextBlock" BasedOn="{StaticResource Wordmark}">
        <Setter Property="FontSize" Value="26" />
    </Style>

    <Style x:Key="CompactTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NoxelFontBody}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Foreground" Value="{ThemeResource NoxelTextPrimary}" />
    </Style>

    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource NoxelBadgeFill}" />
        <Setter Property="CornerRadius" Value="{StaticResource NoxelRadiusSmall}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AccentBadge" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource NoxelAccentSoft}" />
        <Setter Property="CornerRadius" Value="{StaticResource NoxelRadiusSmall}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NoxelFontBody}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="{ThemeResource NoxelTextSecondary}" />
    </Style>

    <Style x:Key="AccentBadgeText" TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
        <Setter Property="Foreground" Value="{ThemeResource NoxelAccentText}" />
    </Style>

    <!-- Large glass tile used for quick actions. Colours fade (BrushTransition); Motion adds a small lift on hover. -->
    <Style x:Key="TileButton" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource NoxelGlassFillSubtle}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NoxelDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource NoxelRadiusCard}" />
        <Setter Property="Padding" Value="10,14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource NoxelTextPrimary}" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid.BackgroundTransition>
                            <BrushTransition Duration="0:0:0.14" />
                        </Grid.BackgroundTransition>
                        <ContentPresenter x:Name="ContentPresenter" Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource NoxelGlassHover}" />
                                        <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource NoxelAccentSoft}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource NoxelAccentSoft}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource NoxelButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="44" />
    </Style>

    <Style x:Key="SubtleGlassButton" TargetType="Button" BasedOn="{StaticResource NoxelButton}">
        <Setter Property="Background" Value="{ThemeResource NoxelGlassFillSubtle}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NoxelDivider}" />
        <Setter Property="CornerRadius" Value="{StaticResource NoxelRadiusPill}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,9" />
    </Style>

    <Style x:Key="NoxelGridViewItem" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
        <Setter Property="Margin" Value="0,0,10,10" />
        <Setter Property="Background" Value="{ThemeResource NoxelGlassFillSubtle}" />
        <Setter Property="CornerRadius" Value="{StaticResource NoxelRadiusControl}" />
    </Style>

    <Style x:Key="NoxelListViewItem" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource NoxelRadiusControl}" />
        <Setter Property="Margin" Value="0,2" />
    </Style>
</ResourceDictionary>
