<Page
    x:Class="Noxel.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:Noxel.App.Controls"
    Background="Transparent">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Layout">
                <VisualState x:Name="Wide" />
                <VisualState x:Name="Medium" />
                <VisualState x:Name="Narrow">
                    <VisualState.Setters>
                        <Setter Target="PagePanel.Padding" Value="16,4,16,20" />
                        <Setter Target="ThemeRadios.MaxColumns" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    <ScrollView x:Name="PageScroll">
        <StackPanel x:Name="PagePanel" Padding="28,6,28,28" Spacing="16" MaxWidth="956" HorizontalAlignment="Left">
            <StackPanel>
                <ctl:ShadowText Text="Settings" TextStyle="{StaticResource PageTitle}" />
                <TextBlock Text="Everything is stored locally in %LOCALAPPDATA%\NOXEL. The only network use is the update check." Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <!-- Appearance -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Appearance" Style="{StaticResource CardTitle}" />
                    <RadioButtons x:Name="ThemeRadios" Header="Theme" MaxColumns="3" SelectionChanged="OnThemeChanged">
                        <x:String>Dark</x:String>
                        <x:String>Light</x:String>
                        <x:String>Follow Windows</x:String>
                    </RadioButtons>
                    <TextBlock Text="Accent color" Style="{StaticResource BodyText}" />
                    <VariableSizedWrapGrid x:Name="Swatches" Orientation="Horizontal" ItemWidth="42" ItemHeight="42" />
                    <Grid ColumnSpacing="8" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HexBox" Width="120" PlaceholderText="#9B7BFF" MaxLength="7" AutomationProperties.Name="Custom accent color (hex)" KeyDown="OnHexKey" />
                        <Button Grid.Column="1" Content="Use custom color" Click="OnHexApply" />
                        <TextBlock x:Name="HexError" Grid.Column="2" Style="{StaticResource FaintText}" VerticalAlignment="Center" Foreground="{ThemeResource NoxelWarning}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Visual effects -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Visual effects" Style="{StaticResource CardTitle}" />
                    <ToggleSwitch x:Name="TransparencySwitch" Header="Transparency" Toggled="OnAppearanceToggled" />
                    <TextBlock Style="{StaticResource FaintText}" Text="Glass behind the window. Off uses solid backgrounds." Margin="0,-6,0,0" />
                    <ComboBox x:Name="MaterialBox" Header="Window material" MinWidth="280" SelectionChanged="OnMaterialChanged">
                        <ComboBoxItem Content="Mica (tinted from your wallpaper)" />
                        <ComboBoxItem Content="Translucent (your desktop, blurred)" />
                    </ComboBox>
                    <TextBlock Style="{StaticResource FaintText}" Text="Translucent shows whatever is behind NOXEL through the glass, blurred. Glass intensity sets how much shows through. Windows turns the blur off by itself when Transparency effects or battery saver are off." Margin="0,-6,0,0" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="360" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Slider x:Name="GlassSlider" Header="Glass intensity" Minimum="0" Maximum="100" StepFrequency="5" ValueChanged="OnGlassChanged" />
                    </Grid>
                    <ToggleSwitch x:Name="AnimationsSwitch" Header="Enable animations" Toggled="OnAppearanceToggled" />
                    <TextBlock Style="{StaticResource FaintText}" Text="Page transitions, hover and press feedback, notices and slider movement. Off makes every change instant." Margin="0,-6,0,0" />
                    <ToggleSwitch x:Name="MotionBlurSwitch" Header="Motion blur" Toggled="OnAppearanceToggled" />
                    <TextBlock x:Name="MotionBlurNote" Style="{StaticResource FaintText}" Margin="0,-6,0,0"
                               Text="A short fading motion trail behind pages as they slide in, drawn by the Windows compositor. Never used while scrolling or on dialogs." />
                    <ToggleSwitch x:Name="SmoothScrollSwitch" Header="Smooth scrolling" Toggled="OnAppearanceToggled" />
                    <TextBlock x:Name="SmoothScrollNote" Style="{StaticResource FaintText}" Margin="0,-6,0,0"
                               Text="Use fluid scrolling and gentle momentum throughout NOXEL." />
                    <ToggleSwitch x:Name="IntroSwitch" Header="Play intro on launch" Toggled="OnStartupToggled" />
                    <TextBlock Style="{StaticResource FaintText}" Text="Show NOXEL's animated startup sequence." Margin="0,-6,0,0" />
                    <TextBlock x:Name="IntroStatus" Style="{StaticResource MutedText}" />
                </StackPanel>
            </Border>

            <!-- Accessibility -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Accessibility" Style="{StaticResource CardTitle}" />
                    <ToggleSwitch x:Name="RespectSystemSwitch" Header="Respect Windows reduced-motion settings" Toggled="OnAppearanceToggled" />
                    <TextBlock x:Name="SystemMotionNote" Style="{StaticResource FaintText}" Margin="0,-6,0,0" />
                    <ToggleSwitch x:Name="ReducedMotionSwitch" Header="Reduced motion" Toggled="OnAppearanceToggled" />
                    <TextBlock Style="{StaticResource FaintText}" Margin="0,-6,0,0"
                               Text="Stops all of NOXEL's movement, including the intro, motion blur and smooth scrolling, whatever the options above say." />
                </StackPanel>
            </Border>

            <!-- Startup -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Startup and window" Style="{StaticResource CardTitle}" />
                    <ToggleSwitch x:Name="StartWithWindowsSwitch" Header="Start NOXEL when I sign in to Windows" Toggled="OnStartupToggled" />
                    <TextBlock Style="{StaticResource FaintText}" Text="Starts in the tray without the intro. Uses a per-user Run entry; no admin rights." />
                    <ToggleSwitch x:Name="StartupCompactSwitch" Header="Open the compact view when started with Windows" Toggled="OnStartupToggled" />
                    <ToggleSwitch x:Name="ReapplySwitch" Header="Turn my last look back on when NOXEL starts" Toggled="OnStartupToggled" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="360" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="DefaultPresetBox" Header="Preset to apply when started with Windows" HorizontalAlignment="Stretch" SelectionChanged="OnDefaultPresetChanged" />
                    </Grid>
                    <ToggleSwitch x:Name="MinimizeTraySwitch" Header="Minimize to the tray" Toggled="OnStartupToggled" />
                    <ToggleSwitch x:Name="CloseTraySwitch" Header="Close button keeps NOXEL running in the tray" Toggled="OnStartupToggled" />
                    <TextBlock Style="{StaticResource FaintText}" Text="When this is off, closing the window exits NOXEL and restores your original colors." />
                </StackPanel>
            </Border>

            <!-- Hotkeys -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="Shortcuts" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="HotkeysSwitch" HorizontalAlignment="Right" OnContent="Enabled" OffContent="Disabled" Toggled="OnHotkeysToggled" AutomationProperties.Name="Enable global shortcuts" />
                    </Grid>
                    <TextBlock Style="{StaticResource FaintText}" Text="Global shortcuts work from anywhere, including games. Select a box and press the keys; Backspace clears, Esc cancels. A key without Ctrl/Alt (like F6) is taken from every other app while NOXEL runs." />
                    <StackPanel x:Name="HotkeyRows" Spacing="8" />
                    <Button Content="Reset shortcuts to defaults" Click="OnResetHotkeys" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Display -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Display" Style="{StaticResource CardTitle}" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="420" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ComboBox x:Name="PreferredMonitorBox" Header="Monitor used by the native / stretched toggle, tray and compact view" HorizontalAlignment="Stretch" SelectionChanged="OnPreferredMonitorChanged" />
                    </Grid>
                    <TextBlock x:Name="NativeStretchedSummary" Style="{StaticResource MutedText}" />
                    <HyperlinkButton Content="Set native and stretched resolutions on the Display page" Click="OnOpenDisplay" Padding="0" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="360" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Slider x:Name="ConfirmSlider" Header="Seconds before an unconfirmed display change reverts" Minimum="5" Maximum="60" StepFrequency="1" ValueChanged="OnConfirmChanged" />
                    </Grid>
                    <Button Content="Forget confirmed display modes" Click="OnForgetModes" HorizontalAlignment="Left"
                            ToolTipService.ToolTip="Modes you confirmed once can be applied by hotkeys and presets without asking again. This makes NOXEL ask again." />
                </StackPanel>
            </Border>

            <!-- Presets -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Presets" Style="{StaticResource CardTitle}" />
                    <StackPanel Orientation="Vertical" Spacing="8" HorizontalAlignment="Left">
                        <Button Content="Manage presets, import and export" Click="OnOpenPresets" />
                        <Button Content="Restore built-in presets" Click="OnRestoreBuiltIns" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Updates" Style="{StaticResource CardTitle}" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="360" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="UpdateModeBox" Header="When a new version is published" HorizontalAlignment="Stretch" SelectionChanged="OnUpdateModeChanged">
                            <x:String>Notify me (recommended)</x:String>
                            <x:String>Download automatically, ask before installing</x:String>
                            <x:String>Only when I check</x:String>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="16" RowSpacing="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Text="Installed" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="UpdCurrent" Grid.Column="1" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Text="Latest" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="UpdLatest" Grid.Row="1" Grid.Column="1" Style="{StaticResource BodyText}" />
                        <TextBlock Grid.Row="2" Text="Last checked" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="UpdChecked" Grid.Row="2" Grid.Column="1" Style="{StaticResource BodyText}" />
                    </Grid>
                    <TextBlock x:Name="UpdStatus" Style="{StaticResource MutedText}" />
                    <StackPanel x:Name="UpdProgressPanel" Spacing="6" Visibility="Collapsed">
                        <TextBlock x:Name="UpdFile" Style="{StaticResource BodyText}" FontWeight="Medium" />
                        <ProgressBar x:Name="UpdBar" Maximum="100" CornerRadius="2" MinHeight="4" />
                        <Grid>
                            <TextBlock x:Name="UpdProgressText" Style="{StaticResource FaintText}" VerticalAlignment="Center" />
                            <Button x:Name="UpdCancel" Content="Cancel" HorizontalAlignment="Right" Click="OnUpdateCancel" />
                        </Grid>
                    </StackPanel>
                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="180" ItemHeight="44">
                        <Button x:Name="UpdCheck" Content="Check for updates" Click="OnUpdateCheck" />
                        <Button x:Name="UpdNotes" Content="View release notes" Click="OnUpdateNotes" />
                        <Button x:Name="UpdDownload" Content="Download update" Click="OnUpdateDownload" />
                        <Button x:Name="UpdInstall" Content="Install update" Style="{StaticResource AccentButtonStyle}" Click="OnUpdateInstall" />
                    </VariableSizedWrapGrid>
                    <TextBlock Style="{StaticResource FaintText}"
                               Text="Updates come only from github.com/reprinted/NOXEL-Releases over HTTPS. A download is installed only after its size, SHA-256 checksum and version match the release, and never during a display Keep/Revert confirmation. Checks happen shortly after start and once a day; nothing runs in between." />
                </StackPanel>
            </Border>

            <!-- Diagnostics -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Diagnostics" Style="{StaticResource CardTitle}" />
                    <ToggleSwitch x:Name="LoggingSwitch" Header="Write a diagnostic log" Toggled="OnLoggingToggled" />
                    <TextBlock Style="{StaticResource FaintText}" Text="The log records display and color operations and errors, never window titles, file contents or typed keys. Crash reports are always kept locally so a failed start can be explained." />
                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="170" ItemHeight="44">
                        <Button Content="Open log folder" Click="OnOpenLogs" />
                        <Button Content="Delete logs" Click="OnDeleteLogs" />
                        <Button Content="Open settings folder" Click="OnOpenSettingsFolder" />
                    </VariableSizedWrapGrid>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource GlassCard}">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="AboutLogo" Source="ms-appx:///Assets/noxel-256.png" Width="84" Height="84" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="6">
                        <ctl:ShadowText Text="NOXEL" TextStyle="{StaticResource WordmarkLarge}" />
                        <TextBlock x:Name="AboutVersion" Style="{StaticResource MutedText}" FontFamily="{StaticResource NoxelMono}" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="AboutDeveloper" Style="{StaticResource MutedText}" />
                        <TextBlock Style="{StaticResource MutedText}" Text="Requires Windows 10 version 1809 or later, or Windows 11 (64-bit)." />
                        <TextBlock Style="{StaticResource MutedText}" Text="NOXEL is free software: you can redistribute it and/or modify it under the terms of the GNU General Public License, version 3 only. It comes with ABSOLUTELY NO WARRANTY. Copyright © 2026 reprinted." />
                        <TextBlock Style="{StaticResource FaintText}" Text="Includes third-party components under their own licenses: Microsoft .NET, the Windows App SDK (WinUI 3) and the WebView2 loader, and the Inter and Rajdhani fonts (SIL Open Font License 1.1). NVIDIA is a trademark of NVIDIA Corporation; NOXEL uses the driver's public NVAPI interface and is not affiliated with NVIDIA." />
                        <TextBlock Style="{StaticResource FaintText}" Text="Privacy: no telemetry, accounts or administrator rights. The only network access is the update check against github.com/reprinted/NOXEL-Releases (can be set to manual). NOXEL never reads or injects into game processes, installs drivers or hooks, or captures the screen." />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button Content="License (GPL v3)" Click="OnOpenLicense" />
                            <Button Content="Source code" Click="OnOpenSource" />
                            <Button Content="Third-party notices" Click="OnOpenNotices" />
                            <Button Content="Open program folder" Click="OnOpenProgramFolder" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollView>
    </Grid>
</Page>
