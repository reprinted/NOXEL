<Page
    x:Class="Noxel.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer>
        <StackPanel Padding="28,6,28,28" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Everything is stored locally in %LOCALAPPDATA%\NOXEL. Nothing is sent anywhere." Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <!-- Appearance -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Appearance" Style="{StaticResource CardTitle}" />
                    <RadioButtons x:Name="ThemeRadios" Header="Theme" MaxColumns="3" SelectionChanged="OnThemeChanged">
                        <x:String>Dark</x:String>
                        <x:String>Light</x:String>
                        <x:String>Follow Windows</x:String>
                    </RadioButtons>
                    <TextBlock Text="Accent color" Style="{StaticResource BodyText}" />
                    <StackPanel x:Name="Swatches" Orientation="Horizontal" Spacing="8" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="HexBox" Width="120" PlaceholderText="#9B7BFF" MaxLength="7" AutomationProperties.Name="Custom accent color (hex)" KeyDown="OnHexKey" />
                        <Button Content="Use custom color" Click="OnHexApply" />
                        <TextBlock x:Name="HexError" Style="{StaticResource FaintText}" VerticalAlignment="Center" Foreground="{ThemeResource NoxelWarning}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="TransparencySwitch" Header="Transparency (Mica / glass)" Toggled="OnAppearanceToggled" />
                    <Slider x:Name="GlassSlider" Header="Glass intensity" Minimum="0" Maximum="100" StepFrequency="5" ValueChanged="OnGlassChanged" MaxWidth="360" HorizontalAlignment="Left" Width="360" />
                    <ToggleSwitch x:Name="AnimationsSwitch" Header="Animations and page transitions" Toggled="OnAppearanceToggled" />
                    <ToggleSwitch x:Name="ReducedMotionSwitch" Header="Reduced motion (overrides everything above, including the intro)" Toggled="OnAppearanceToggled" />
                    <TextBlock x:Name="SystemMotionNote" Style="{StaticResource FaintText}" />
                </StackPanel>
            </Border>

            <!-- Startup -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Startup and window" Style="{StaticResource CardTitle}" />
                    <ToggleSwitch x:Name="StartWithWindowsSwitch" Header="Start NOXEL when I sign in to Windows" Toggled="OnStartupToggled" />
                    <TextBlock Style="{StaticResource FaintText}" Text="Starts in the tray without the intro. Uses a per-user Run entry; no admin rights." />
                    <ToggleSwitch x:Name="StartupCompactSwitch" Header="Open the compact view when started with Windows" Toggled="OnStartupToggled" />
                    <ToggleSwitch x:Name="ReapplySwitch" Header="Turn my last look back on when NOXEL starts" Toggled="OnStartupToggled" />
                    <ComboBox x:Name="DefaultPresetBox" Header="Preset to apply when started with Windows" MinWidth="280" SelectionChanged="OnDefaultPresetChanged" />
                    <ToggleSwitch x:Name="MinimizeTraySwitch" Header="Minimize to the tray" Toggled="OnStartupToggled" />
                    <ToggleSwitch x:Name="CloseTraySwitch" Header="Close button keeps NOXEL running in the tray" Toggled="OnStartupToggled" />
                    <TextBlock Style="{StaticResource FaintText}" Text="When this is off, closing the window exits NOXEL and restores your original colors." />
                    <ToggleSwitch x:Name="IntroSwitch" Header="Play the eye intro on launch" Toggled="OnStartupToggled" />
                    <ToggleSwitch x:Name="IntroSystemSwitch" Header="Play the intro even when Windows animation effects are off" Toggled="OnStartupToggled" />
                    <ToggleSwitch x:Name="IntroRestoreSwitch" Header="Also play it when reopening from the tray" Toggled="OnStartupToggled" />
                </StackPanel>
            </Border>

            <!-- Hotkeys -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="Shortcuts" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="HotkeysSwitch" HorizontalAlignment="Right" OnContent="Enabled" OffContent="Disabled" Toggled="OnHotkeysToggled" AutomationProperties.Name="Enable global shortcuts" />
                    </Grid>
                    <TextBlock Style="{StaticResource FaintText}" Text="Global shortcuts work from anywhere, including games. Select a box and press the keys; Backspace clears, Esc cancels. A key without Ctrl/Alt (like F6) is taken from every other app while NOXEL runs." />
                    <StackPanel x:Name="HotkeyRows" Spacing="8" />
                    <Button Content="Reset shortcuts to defaults" Click="OnResetHotkeys" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Display -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Display" Style="{StaticResource CardTitle}" />
                    <ComboBox x:Name="PreferredMonitorBox" Header="Monitor used by the native / stretched toggle, tray and compact view" MinWidth="320" SelectionChanged="OnPreferredMonitorChanged" />
                    <TextBlock x:Name="NativeStretchedSummary" Style="{StaticResource MutedText}" />
                    <HyperlinkButton Content="Set native and stretched resolutions on the Display page" Click="OnOpenDisplay" Padding="0" />
                    <Slider x:Name="ConfirmSlider" Header="Seconds before an unconfirmed display change reverts" Minimum="5" Maximum="60" StepFrequency="1" Width="360" HorizontalAlignment="Left" ValueChanged="OnConfirmChanged" />
                    <Button Content="Forget confirmed display modes" Click="OnForgetModes" HorizontalAlignment="Left"
                            ToolTipService.ToolTip="Modes you confirmed once can be applied by hotkeys and presets without asking again. This makes NOXEL ask again." />
                </StackPanel>
            </Border>

            <!-- Presets -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Presets" Style="{StaticResource CardTitle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Manage presets, import and export" Click="OnOpenPresets" />
                        <Button Content="Restore built-in presets" Click="OnRestoreBuiltIns" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Diagnostics -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Diagnostics" Style="{StaticResource CardTitle}" />
                    <ToggleSwitch x:Name="LoggingSwitch" Header="Write a diagnostic log" Toggled="OnLoggingToggled" />
                    <TextBlock Style="{StaticResource FaintText}" Text="The log records display and color operations and errors, never window titles, file contents or typed keys. Crash reports are always kept locally so a failed start can be explained." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Open log folder" Click="OnOpenLogs" />
                        <Button Content="Delete logs" Click="OnDeleteLogs" />
                        <Button Content="Open settings folder" Click="OnOpenSettingsFolder" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource GlassCard}">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="ms-appx:///Assets/noxel-256.png" Width="84" Height="84" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="NOXEL" FontSize="22" FontWeight="Bold" CharacterSpacing="200" Foreground="{ThemeResource NoxelTextPrimary}" />
                        <TextBlock x:Name="AboutVersion" Style="{StaticResource MutedText}" FontFamily="{StaticResource NoxelMono}" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="AboutDeveloper" Style="{StaticResource MutedText}" />
                        <TextBlock Style="{StaticResource MutedText}" Text="Requires Windows 10 version 1809 or later, or Windows 11 (64-bit)." />
                        <TextBlock Style="{StaticResource MutedText}" Text="License: see LICENSE.txt next to the program. Third-party notices: THIRD-PARTY-NOTICES.md." />
                        <TextBlock Style="{StaticResource FaintText}" Text="Built with .NET and the Windows App SDK (WinUI 3), both by Microsoft under their respective licenses. NVIDIA is a trademark of NVIDIA Corporation; NOXEL uses the driver's public NVAPI interface and is not affiliated with NVIDIA." />
                        <TextBlock Style="{StaticResource FaintText}" Text="Privacy: no network access, telemetry, accounts or administrator rights. NOXEL never reads or injects into game processes, installs drivers or hooks, or captures the screen." />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button Content="Open program folder" Click="OnOpenProgramFolder" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
