<Window
    x:Class="Noxel.App.Views.CompactWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:Noxel.App.Controls"
    Title="NOXEL">
    <Grid x:Name="Root">
        <Rectangle Fill="{ThemeResource NoxelWindowTint}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <Grid x:Name="ContentLayout" VerticalAlignment="Top" Padding="16,10,16,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="DragArea" ColumnSpacing="12" Background="Transparent" Margin="0,0,118,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="10" BorderBrush="{ThemeResource NoxelGlassStroke}" BorderThickness="1">
                    <Image Source="ms-appx:///Assets/noxel-256.png" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="PresetName" Text="NOXEL" Style="{StaticResource CompactTitle}" />
                    <TextBlock x:Name="ModeText" Style="{StaticResource MutedText}" FontFamily="{StaticResource NoxelMono}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </Grid>
            <ToggleSwitch x:Name="ColorSwitch" OnContent="" OffContent="" MinWidth="0" Width="44" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,6,34,0" Toggled="OnColorToggled" AutomationProperties.Name="Color effects" ToolTipService.ToolTip="Color effects on/off" />
            <Grid Grid.Row="1" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="PresetBox" HorizontalAlignment="Stretch" SelectionChanged="OnPresetChanged" AutomationProperties.Name="Preset" PlaceholderText="Choose a preset" />
                <ToggleButton x:Name="PinButton" Grid.Column="1" Click="OnPin" Padding="9" AutomationProperties.Name="Keep on top" ToolTipService.ToolTip="Keep on top">
                    <FontIcon Glyph="&#xE718;" FontSize="14" />
                </ToggleButton>
                <Button Grid.Column="2" Click="OnFull" Padding="9" AutomationProperties.Name="Full view" ToolTipService.ToolTip="Full view">
                    <FontIcon Glyph="&#xE740;" FontSize="14" />
                </Button>
            </Grid>
        </Grid>
        </ScrollViewer>
    </Grid>
</Window>
