<Page
    x:Class="Noxel.App.Views.DisplayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:Noxel.App.Controls"
    xmlns:vm="using:Noxel.App.ViewModels"
    Background="Transparent">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Layout">
                <VisualState x:Name="Wide" />
                <VisualState x:Name="Medium">
                    <VisualState.Setters>
                        <Setter Target="SideCol.Width" Value="0" />
                        <Setter Target="SidePanel.(Grid.Column)" Value="0" />
                        <Setter Target="SidePanel.(Grid.Row)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.Setters>
                        <Setter Target="SideCol.Width" Value="0" />
                        <Setter Target="SidePanel.(Grid.Column)" Value="0" />
                        <Setter Target="SidePanel.(Grid.Row)" Value="1" />
                        <Setter Target="PagePanel.Padding" Value="16,4,16,20" />
                        <Setter Target="StripStats.(Grid.Row)" Value="1" />
                        <Setter Target="StripStats.(Grid.Column)" Value="0" />
                        <Setter Target="StripStats.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="StripStats.ItemWidth" Value="140" />
                        <Setter Target="MonitorBox.MinWidth" Value="0" />
                        <Setter Target="PickerPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="SearchBox.(Grid.Row)" Value="1" />
                        <Setter Target="SearchBox.(Grid.Column)" Value="0" />
                        <Setter Target="SearchBox.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="SearchBox.Width" Value="NaN" />
                        <Setter Target="AspectBox.(Grid.Row)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollView x:Name="PageScroll">
            <StackPanel x:Name="PagePanel" Padding="28,6,28,28" Spacing="16" MaxWidth="1320">
                <StackPanel>
                    <ctl:ShadowText Text="Display" TextStyle="{StaticResource PageTitle}" />
                    <TextBlock Text="Switch to any mode your graphics driver exposes. Every change asks you to confirm and reverts on its own if you don't." Style="{StaticResource PageSubtitle}" />
                </StackPanel>

                <!-- Monitor strip -->
                <Border Style="{StaticResource GlassCard}">
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="PickerPanel" Spacing="4">
                            <TextBlock Text="MONITOR" Style="{StaticResource SectionLabel}" />
                            <ComboBox x:Name="MonitorBox" MinWidth="260" HorizontalAlignment="Stretch" SelectionChanged="OnMonitorChanged" AutomationProperties.Name="Monitor to edit" />
                        </StackPanel>
                        <VariableSizedWrapGrid x:Name="StripStats" Grid.Column="1" Orientation="Horizontal" ItemWidth="150" ItemHeight="46" VerticalAlignment="Center">
                            <StackPanel><TextBlock Text="CURRENT" Style="{StaticResource SectionLabel}" /><TextBlock x:Name="CurText" Style="{StaticResource StatValue}" FontSize="17" /></StackPanel>
                            <StackPanel><TextBlock Text="REFRESH" Style="{StaticResource SectionLabel}" /><TextBlock x:Name="CurHzText" Style="{StaticResource StatValue}" FontSize="17" /></StackPanel>
                            <StackPanel><TextBlock Text="NATIVE" Style="{StaticResource SectionLabel}" /><TextBlock x:Name="NativeText" Style="{StaticResource StatValue}" FontSize="17" /></StackPanel>
                            <StackPanel><TextBlock Text="ORIENTATION" Style="{StaticResource SectionLabel}" /><TextBlock x:Name="OrientText" Style="{StaticResource StatValue}" FontSize="13" FontWeight="SemiBold" FontFamily="{ThemeResource ContentControlThemeFontFamily}" /></StackPanel>
                            <StackPanel><TextBlock Text="CONNECTION" Style="{StaticResource SectionLabel}" /><TextBlock x:Name="ConnText" Style="{StaticResource StatValue}" FontSize="13" FontWeight="SemiBold" FontFamily="{ThemeResource ContentControlThemeFontFamily}" /></StackPanel>
                            <StackPanel><TextBlock Text="ROLE" Style="{StaticResource SectionLabel}" /><TextBlock x:Name="RoleText" Style="{StaticResource StatValue}" FontSize="13" FontWeight="SemiBold" FontFamily="{ThemeResource ContentControlThemeFontFamily}" /></StackPanel>
                        </VariableSizedWrapGrid>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="OnRefresh" VerticalAlignment="Center" AutomationProperties.Name="Re-scan monitors" ToolTipService.ToolTip="Re-scan monitors">
                            <FontIcon Glyph="&#xE72C;" FontSize="15" />
                        </Button>
                        <TextBlock x:Name="IdText" Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource FaintText}" FontFamily="{StaticResource NoxelMono}" IsTextSelectionEnabled="True" />
                    </Grid>
                </Border>

                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="SideCol" Width="380" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Resolution cards -->
                    <Border Style="{StaticResource GlassCard}" VerticalAlignment="Top">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="10" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Resolutions" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                <TextBox x:Name="SearchBox" Grid.Column="1" Width="170" PlaceholderText="Search, e.g. 1440" TextChanged="OnFilterChanged" AutomationProperties.Name="Search resolutions" />
                                <ComboBox x:Name="AspectBox" Grid.Column="2" Width="110" SelectedIndex="0" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Aspect ratio filter">
                                    <x:String>All</x:String>
                                    <x:String>16:9</x:String>
                                    <x:String>16:10</x:String>
                                    <x:String>4:3</x:String>
                                    <x:String>5:4</x:String>
                                    <x:String>21:9</x:String>
                                    <x:String>Other</x:String>
                                </ComboBox>
                            </Grid>
                            <TextBlock Style="{StaticResource FaintText}" Text="Starred resolutions are listed first. Select a card, pick a refresh rate, then Apply." />
                            <GridView x:Name="ResGrid" SelectionMode="Single" SelectionChanged="OnResolutionSelected" IsItemClickEnabled="False"
                                      AutomationProperties.Name="Resolutions" Padding="0">
                                <GridView.ItemContainerStyle>
                                    <StaticResource ResourceKey="NoxelGridViewItem" />
                                </GridView.ItemContainerStyle>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ResolutionItem">
                                        <Grid Width="164" Height="78" Padding="12,10,6,10" AutomationProperties.Name="{x:Bind AutomationName}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Text}" FontFamily="{StaticResource NoxelFontBrand}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource NoxelTextPrimary}" />
                                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource FaintText}" />
                                                <TextBlock Text="{x:Bind Badge}" Visibility="{x:Bind BadgeVisibility}" FontSize="10" FontWeight="Bold" CharacterSpacing="60" Foreground="{ThemeResource NoxelAccentText}" />
                                            </StackPanel>
                                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Padding="4" Margin="0,-4,0,0" Background="Transparent" BorderThickness="0"
                                                    Tag="{x:Bind}" Click="OnFavoriteClick" ToolTipService.ToolTip="{x:Bind FavTip}" AutomationProperties.Name="{x:Bind FavTip}">
                                                <FontIcon Glyph="{x:Bind FavGlyph}" FontSize="13" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                            <TextBlock x:Name="EmptyText" Text="No resolutions match." Style="{StaticResource MutedText}" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="SidePanel" Grid.Column="1" Spacing="16">
                        <!-- Mode -->
                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Mode" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="SelText" Text="Select a resolution" Style="{StaticResource StatValueLarge}" />
                                <TextBlock Text="REFRESH RATE" Style="{StaticResource SectionLabel}" />
                                <ComboBox x:Name="HzBox" HorizontalAlignment="Stretch" SelectionChanged="OnHzChanged" AutomationProperties.Name="Refresh rate" />
                                <Grid ColumnSpacing="8" RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Current" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="HzCurrent" Grid.Column="1" Style="{StaticResource StatValue}" FontSize="15" />
                                    <TextBlock Grid.Row="1" Text="Highest for this mode" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="HzMax" Grid.Row="1" Grid.Column="1" Style="{StaticResource StatValue}" FontSize="15" />
                                    <TextBlock Grid.Row="2" Text="Selected" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="HzSelected" Grid.Row="2" Grid.Column="1" Style="{StaticResource StatValue}" FontSize="15" />
                                </Grid>
                                <TextBlock Text="GPU SCALING" Style="{StaticResource SectionLabel}" />
                                <ComboBox x:Name="ScalingBox" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="OnScalingChanged" AutomationProperties.Name="GPU scaling">
                                    <x:String>Don't change</x:String>
                                    <x:String>Driver / monitor default</x:String>
                                    <x:String>Stretch to fill (GPU)</x:String>
                                    <x:String>Centered, no scaling</x:String>
                                </ComboBox>
                                <TextBlock x:Name="ScalingNote" Style="{StaticResource FaintText}" />
                                <TextBlock x:Name="ModeWarning" Style="{StaticResource MutedText}" Foreground="{ThemeResource NoxelWarning}" Visibility="Collapsed" />
                                <Button x:Name="ApplyButton" Content="Apply" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="OnApply" IsEnabled="False" />
                            </StackPanel>
                        </Border>

                        <!-- Native / stretched -->
                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Native / stretched" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="ToggleTarget" Style="{StaticResource FaintText}" />
                                <TextBlock Text="NATIVE" Style="{StaticResource SectionLabel}" />
                                <ComboBox x:Name="NativeBox" HorizontalAlignment="Stretch" SelectionChanged="OnNativeStretchedChanged" AutomationProperties.Name="Native resolution" />
                                <TextBlock Text="STRETCHED" Style="{StaticResource SectionLabel}" />
                                <ComboBox x:Name="StretchedBox" HorizontalAlignment="Stretch" SelectionChanged="OnNativeStretchedChanged" AutomationProperties.Name="Stretched resolution" />
                                <ComboBox x:Name="StretchedHzBox" HorizontalAlignment="Stretch" SelectionChanged="OnNativeStretchedChanged" AutomationProperties.Name="Stretched refresh rate" />
                                <ComboBox x:Name="StretchedScalingBox" HorizontalAlignment="Stretch" SelectionChanged="OnNativeStretchedChanged" AutomationProperties.Name="Scaling for stretched mode">
                                    <x:String>Scaling: don't change</x:String>
                                    <x:String>Scaling: driver / monitor default</x:String>
                                    <x:String>Scaling: stretch to fill (GPU)</x:String>
                                    <x:String>Scaling: centered</x:String>
                                </ComboBox>
                                <TextBlock Style="{StaticResource FaintText}" Text="Switching resolution doesn't by itself stretch the image. Whether 4:3 fills the screen depends on the scaling mode your GPU or monitor uses; NOXEL can request GPU stretch, but some drivers ignore it." />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ToggleButton" Content="Toggle now" HorizontalAlignment="Stretch" Click="OnToggleNow" />
                                    <Border Grid.Column="1" Style="{StaticResource Badge}">
                                        <TextBlock x:Name="ToggleHotkey" Style="{StaticResource BadgeText}" FontFamily="{StaticResource NoxelMono}" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Custom -->
                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Custom resolution" Style="{StaticResource CardTitle}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CustomBox" PlaceholderText="e.g. 1440x1080 or 1440x1080@240" KeyDown="OnCustomKey" AutomationProperties.Name="Custom resolution" />
                                    <Button Grid.Column="1" Content="Find" Click="OnCustomFind" />
                                </Grid>
                                <TextBlock x:Name="CustomResult" Style="{StaticResource MutedText}" />
                                <TextBlock Style="{StaticResource FaintText}" Text="Windows can only switch to modes the driver already offers. To add a new one (for example 1568×1080), create it in NVIDIA Control Panel, AMD Software or a tool like CRU first; it will then appear here." />
                            </StackPanel>
                        </Border>

                        <!-- Inactive monitors -->
                        <Border x:Name="InactiveCard" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Connected, not in use" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="InactiveList" Style="{StaticResource MutedText}" />
                                <TextBlock Style="{StaticResource FaintText}" Text="NOXEL never turns monitors on or off by itself. Use Windows Settings ▸ Display to extend or disconnect a monitor." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>
