<Page
    x:Class="Noxel.App.Views.PresetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Noxel.App.ViewModels"
    xmlns:ctl="using:Noxel.App.Controls"
    Background="Transparent" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Layout">
                <VisualState x:Name="Wide" />
                <VisualState x:Name="Medium">
                    <VisualState.Setters>
                        <Setter Target="SideCol.Width" Value="0" />
                        <Setter Target="Editor.(Grid.Column)" Value="0" />
                        <Setter Target="Editor.(Grid.Row)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.Setters>
                        <Setter Target="SideCol.Width" Value="0" />
                        <Setter Target="Editor.(Grid.Column)" Value="0" />
                        <Setter Target="Editor.(Grid.Row)" Value="1" />
                        <Setter Target="PagePanel.Padding" Value="16,4,16,20" />
                        <Setter Target="Toolbar.(Grid.Row)" Value="1" />
                        <Setter Target="Toolbar.(Grid.Column)" Value="0" />
                        <Setter Target="SearchBox.MaxWidth" Value="Infinity" />
                        <Setter Target="LblNewfromcurrent.Visibility" Value="Collapsed" />
                        <Setter Target="LblImport.Visibility" Value="Collapsed" />
                        <Setter Target="LblExportall.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollView x:Name="PageScroll">
            <StackPanel x:Name="PagePanel" Padding="28,6,28,28" Spacing="16" MaxWidth="1320">
                <StackPanel>
                    <ctl:ShadowText Text="Presets" TextStyle="{StaticResource PageTitle}" />
                    <TextBlock Text="Save complete setups: resolution, refresh rate and colors together. Star favorites for the dashboard, tray and Ctrl + Shift + 1/2." Style="{StaticResource PageSubtitle}" />
                </StackPanel>

                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="SearchBox" PlaceholderText="Search presets" MaxWidth="320" HorizontalAlignment="Stretch" TextChanged="OnSearch" AutomationProperties.Name="Search presets" />
                    <StackPanel x:Name="Toolbar" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Click="OnNew" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="13" /><TextBlock x:Name="LblNewfromcurrent" Text="New from current" /></StackPanel>
                        </Button>
                        <Button Click="OnImport" ToolTipService.ToolTip="Import presets from a .json file (you can also drop files here)">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B5;" FontSize="13" /><TextBlock x:Name="LblImport" Text="Import" /></StackPanel>
                        </Button>
                        <Button Click="OnExportAll">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72D;" FontSize="13" /><TextBlock x:Name="LblExportall" Text="Export all" /></StackPanel>
                        </Button>
                        <Button Click="OnRestoreBuiltIns" ToolTipService.ToolTip="Reset built-in favorites and hotkeys and clear the Custom slot">
                            <FontIcon Glyph="&#xE777;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="SideCol" Width="400" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource GlassCard}" Padding="8" VerticalAlignment="Top">
                        <ListView x:Name="List" SelectionMode="Single" SelectionChanged="OnSelected" AutomationProperties.Name="Presets"
                                  ItemContainerStyle="{StaticResource NoxelListViewItem}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PresetItem">
                                    <Grid ColumnSpacing="12" Padding="4,10" AutomationProperties.Name="{x:Bind Name}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Tag="{x:Bind}" Click="OnStar" Padding="6" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                                ToolTipService.ToolTip="{x:Bind FavTip}" AutomationProperties.Name="{x:Bind FavTip}">
                                            <FontIcon Glyph="{x:Bind FavGlyph}" FontSize="15" />
                                        </Button>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{ThemeResource NoxelTextPrimary}" />
                                                <Border Style="{StaticResource AccentBadge}" Visibility="{x:Bind ActiveVisibility}"><TextBlock Text="ACTIVE" Style="{StaticResource AccentBadgeText}" /></Border>
                                                <FontIcon Glyph="&#xE72E;" FontSize="11" Visibility="{x:Bind LockVisibility}" Foreground="{ThemeResource NoxelTextTertiary}" ToolTipService.ToolTip="Built-in" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Description}" Style="{StaticResource FaintText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Text="{x:Bind Summary}" Style="{StaticResource FaintText}" FontFamily="{StaticResource NoxelMono}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Style="{StaticResource Badge}" Visibility="{x:Bind HotkeyVisibility}">
                                                <TextBlock Text="{x:Bind HotkeyText}" Style="{StaticResource BadgeText}" FontFamily="{StaticResource NoxelMono}" />
                                            </Border>
                                            <Button Content="Apply" Tag="{x:Bind}" Click="OnApplyItem" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <!-- Editor -->
                    <Border x:Name="Editor" Grid.Column="1" Style="{StaticResource GlassCard}" VerticalAlignment="Top">
                        <StackPanel Spacing="10">
                            <ctl:ShadowText x:Name="EditorTitle" Text="Preset" TextStyle="{StaticResource CardTitle}" />
                            <TextBlock x:Name="BuiltInNote" Style="{StaticResource FaintText}" Text="Built-in presets can't be edited or deleted. Duplicate one to make your own copy. You can still star it and give it a shortcut." />
                            <TextBox x:Name="NameBox" Header="Name" MaxLength="48" />
                            <TextBox x:Name="DescBox" Header="Description" MaxLength="160" />

                            <Rectangle Height="1" Fill="{ThemeResource NoxelDivider}" Margin="0,4" />
                            <CheckBox x:Name="IncludeDisplay" Content="Change display mode" Checked="OnIncludeChanged" Unchecked="OnIncludeChanged" />
                            <StackPanel x:Name="DisplayFields" Spacing="8">
                                <ComboBox x:Name="PMonitorBox" Header="Monitor" HorizontalAlignment="Stretch" SelectionChanged="OnPMonitorChanged" />
                                <ComboBox x:Name="PResBox" Header="Resolution" HorizontalAlignment="Stretch" SelectionChanged="OnPResChanged" />
                                <ComboBox x:Name="PHzBox" Header="Refresh rate" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <Rectangle Height="1" Fill="{ThemeResource NoxelDivider}" Margin="0,4" />
                            <CheckBox x:Name="IncludeColor" Content="Change colors" Checked="OnIncludeChanged" Unchecked="OnIncludeChanged" />
                            <StackPanel x:Name="ColorFields" Spacing="8">
                                <ToggleSwitch x:Name="ColorOnSwitch" Header="Color effects when applied" OnContent="On" OffContent="Off" />
                                <TextBlock x:Name="ColorSummary" Style="{StaticResource MutedText}" FontFamily="{StaticResource NoxelMono}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="UseCurrentColors" Content="Use current look" Click="OnUseCurrentColors" ToolTipService.ToolTip="Copy the sliders from Color Studio into this preset" />
                                    <Button Content="Edit in Color Studio" Click="OnEditColors" />
                                </StackPanel>
                            </StackPanel>

                            <Rectangle Height="1" Fill="{ThemeResource NoxelDivider}" Margin="0,4" />
                            <TextBlock Text="SHORTCUT" Style="{StaticResource SectionLabel}" />
                            <ctl:HotkeyRecorder x:Name="HotkeyBox" HorizontalAlignment="Stretch" />
                            <TextBlock x:Name="HotkeyError" Style="{StaticResource FaintText}" Foreground="{ThemeResource NoxelWarning}" Visibility="Collapsed" />
                            <TextBlock x:Name="MetaText" Style="{StaticResource FaintText}" />

                            <Grid ColumnSpacing="8" RowSpacing="8" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <Button x:Name="SaveButton" Content="Save" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="OnSave" />
                                <Button x:Name="ApplyButton" Grid.Column="1" Content="Apply" HorizontalAlignment="Stretch" Click="OnApply" />
                                <Button Grid.Column="2" Content="Duplicate" HorizontalAlignment="Stretch" Click="OnDuplicate" />
                                <Button Grid.Row="1" Content="Export…" HorizontalAlignment="Stretch" Click="OnExportOne" />
                                <Button x:Name="UpdateButton" Grid.Row="1" Grid.Column="1" Content="From current" HorizontalAlignment="Stretch" Click="OnFromCurrent"
                                        ToolTipService.ToolTip="Replace this preset's display mode and colors with what is active right now" />
                                <Button x:Name="DeleteButton" Grid.Row="1" Grid.Column="2" Content="Delete" HorizontalAlignment="Stretch" Click="OnDelete" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>
