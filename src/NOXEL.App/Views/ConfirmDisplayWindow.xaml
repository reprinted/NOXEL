<Window
    x:Class="Noxel.App.Views.ConfirmDisplayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NOXEL · Confirm display change">
    <Grid x:Name="Root" KeyDown="OnKeyDown">
        <Rectangle Fill="{ThemeResource NoxelWindowTint}" />
        <Grid x:Name="DragBar" Height="36" VerticalAlignment="Top" Background="Transparent" Padding="14,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/noxel-64.png" Width="16" Height="16" />
                <TextBlock Text="NOXEL" FontSize="12" FontWeight="SemiBold" CharacterSpacing="160" Foreground="{ThemeResource NoxelTextSecondary}" />
            </StackPanel>
        </Grid>
        <Grid Margin="24,46,24,20" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Keep the recovery actions visible even with large text or a long monitor name. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <StackPanel Spacing="10">
            <TextBlock Text="Keep these display settings?" TextWrapping="Wrap" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource NoxelTextPrimary}" />
            <TextBlock x:Name="Detail" Style="{StaticResource BodyText}" />
            <TextBlock x:Name="Note" Style="{StaticResource MutedText}" Visibility="Collapsed" />
            <TextBlock x:Name="Countdown" Style="{StaticResource MutedText}" />
            <ProgressBar x:Name="Progress" Maximum="15" Value="15" />
            </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="RevertButton" AutomationProperties.Name="Revert" HorizontalAlignment="Stretch" Click="OnRevert">
                    <TextBlock Text="Revert" TextWrapping="Wrap" TextAlignment="Center" />
                </Button>
                <Button x:Name="KeepButton" Grid.Column="1" AutomationProperties.Name="Keep changes" Style="{StaticResource NoxelPrimaryButton}" HorizontalAlignment="Stretch" Click="OnKeep">
                    <TextBlock Text="Keep changes" TextWrapping="Wrap" TextAlignment="Center" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
