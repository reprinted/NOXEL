<Window
    x:Class="Noxel.App.Views.ConfirmDisplayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NOXEL · Confirm display change">
    <Grid x:Name="Root" KeyDown="OnKeyDown">
        <Rectangle Fill="{ThemeResource NoxelWindowTint}" />
        <Grid x:Name="DragBar" Height="36" VerticalAlignment="Top" Background="Transparent" Padding="14,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/noxel-64.png" Width="16" Height="16" />
                <TextBlock Text="NOXEL" FontSize="12" FontWeight="SemiBold" CharacterSpacing="160" Foreground="{ThemeResource NoxelTextSecondary}" />
            </StackPanel>
        </Grid>
        <StackPanel Margin="24,46,24,20" Spacing="10">
            <TextBlock Text="Keep these display settings?" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource NoxelTextPrimary}" />
            <TextBlock x:Name="Detail" Style="{StaticResource BodyText}" />
            <TextBlock x:Name="Note" Style="{StaticResource MutedText}" Visibility="Collapsed" />
            <TextBlock x:Name="Countdown" Style="{StaticResource MutedText}" />
            <ProgressBar x:Name="Progress" Maximum="15" Value="15" />
            <Grid ColumnSpacing="10" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="RevertButton" Content="Revert" HorizontalAlignment="Stretch" Click="OnRevert" />
                <Button x:Name="KeepButton" Grid.Column="1" Content="Keep changes" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="OnKeep" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
