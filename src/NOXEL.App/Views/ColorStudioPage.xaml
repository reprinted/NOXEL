<Page
    x:Class="Noxel.App.Views.ColorStudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:Noxel.App.Controls"
    Background="Transparent">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Layout">
                <VisualState x:Name="Wide" />
                <VisualState x:Name="Medium">
                    <VisualState.Setters>
                        <Setter Target="SideCol.Width" Value="0" />
                        <Setter Target="SidePanel.(Grid.Column)" Value="0" />
                        <Setter Target="SidePanel.(Grid.Row)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.Setters>
                        <Setter Target="SideCol.Width" Value="0" />
                        <Setter Target="SidePanel.(Grid.Column)" Value="0" />
                        <Setter Target="SidePanel.(Grid.Row)" Value="1" />
                        <Setter Target="PagePanel.Padding" Value="16,8,16,24" />
                        <Setter Target="PagePanel.Spacing" Value="16" />
                        <Setter Target="PageHeading.FontSize" Value="26" />
                        <Setter Target="MasterPanel.(Grid.Row)" Value="1" />
                        <Setter Target="MasterPanel.(Grid.Column)" Value="0" />
                        <Setter Target="MasterPanel.HorizontalAlignment" Value="Left" />
                        <Setter Target="LiveSwitch.(Grid.Row)" Value="1" />
                        <Setter Target="LiveSwitch.(Grid.Column)" Value="0" />
                        <Setter Target="LiveSwitch.HorizontalAlignment" Value="Left" />
                        <Setter Target="LookDetails.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollView x:Name="PageScroll">
            <StackPanel x:Name="PagePanel" Padding="32,12,32,32" Spacing="24" MaxWidth="1320">
                <Grid x:Name="HeaderGrid" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Color Studio" x:Name="PageHeading" Style="{StaticResource PageTitle}" />
                        <TextBlock x:Name="Subtitle" Text="Adjust your display colors. Changes apply to all displays." Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                    <StackPanel x:Name="MasterPanel" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="AppliedText" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="MasterSwitch" OnContent="Effects on" OffContent="Effects off" Toggled="OnMasterToggled" AutomationProperties.Name="Color effects" />
                    </StackPanel>
                </Grid>

                <InfoBar x:Name="HdrBar" Severity="Warning" IsClosable="False" Title="HDR is on"
                         Message="Windows ignores color matrices and gamma ramps for HDR output. Turn HDR off in Windows display settings to use those controls." />

                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="SideCol" Width="340" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource GlassCard}" VerticalAlignment="Top" Padding="20,18">
                        <StackPanel Spacing="4">
                            <Grid Margin="0,0,0,8" ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="LookDetails">
                                    <TextBlock x:Name="LookName" Text="Custom look" Style="{StaticResource CardTitle}" />
                                    <TextBlock x:Name="LookSummary" Style="{StaticResource FaintText}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="LiveSwitch" Grid.Column="1" HorizontalAlignment="Right" OnContent="Live preview" OffContent="Live preview" Toggled="OnLiveToggled"
                                              AutomationProperties.Name="Live preview" ToolTipService.ToolTip="Apply changes while you drag" />
                            </Grid>
                            <StackPanel x:Name="Rows" Spacing="6" />
                            <TextBlock Style="{StaticResource FaintText}" Margin="0,8,0,0"
                                       Text="Type a value and press Enter for an exact setting. Double-click a slider to reset it." />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="SidePanel" Grid.Column="1" Spacing="16">
                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Actions" Style="{StaticResource CardTitle}" />
                                <Button x:Name="ApplyButton" Content="Apply look" Style="{StaticResource NoxelPrimaryButton}" HorizontalAlignment="Stretch" Click="OnApply" />
                                <ToggleButton x:Name="CompareButton" HorizontalAlignment="Stretch" CornerRadius="{StaticResource NoxelRadiusPill}" Checked="OnCompare" Unchecked="OnCompare"
                                              Content="Compare with original" AutomationProperties.Name="Compare with original colors" />
                                <Button Content="Save as preset…" HorizontalAlignment="Stretch" Click="OnSave" />
                                <Button x:Name="UpdatePresetButton" HorizontalAlignment="Stretch" Click="OnUpdatePreset" />
                                <Button Content="Reset all sliders" HorizontalAlignment="Stretch" Click="OnResetAll" />
                                <Button Content="Restore original colors" HorizontalAlignment="Stretch" Click="OnRestore"
                                        ToolTipService.ToolTip="Turns every effect off and restores the colors Windows had before NOXEL." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Import a look" Style="{StaticResource CardTitle}" />
                                <Grid>
                                <TextBox x:Name="ImportBox" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="OnImportTextChanged"
                                         MinHeight="44" MaxHeight="110" Padding="12,10" VerticalContentAlignment="Center"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource NoxelMono}" FontSize="12"
                                         AutomationProperties.Name="Look code to import" KeyDown="OnImportKey" />
                                <TextBlock x:Name="ImportPlaceholder" Text="Paste a NOXEL-LOOK code or preset JSON"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Center" TextAlignment="Left"
                                           Margin="12,10" TextWrapping="Wrap" IsHitTestVisible="False"
                                           FontFamily="{StaticResource NoxelMono}" FontSize="12"
                                           Foreground="{ThemeResource NoxelTextSecondary}" AutomationProperties.AccessibilityView="Raw" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Import" Style="{StaticResource NoxelPrimaryButton}" HorizontalAlignment="Stretch" Click="OnImportLook" />
                                    <Button Grid.Column="1" Content="From file…" HorizontalAlignment="Stretch" Click="OnImportFile"
                                            ToolTipService.ToolTip="Load colours from a NOXEL preset file (.json / .noxel)" />
                                </Grid>
                                <TextBlock x:Name="ImportStatus" Style="{StaticResource FaintText}" Visibility="Collapsed" />
                                <Rectangle Height="1" Fill="{ThemeResource NoxelDivider}" />
                                <Button Content="Copy current look code" HorizontalAlignment="Stretch" Click="OnCopyLook"
                                        ToolTipService.ToolTip="Copies a short text code anyone can paste into NOXEL" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="How each control works" Style="{StaticResource CardTitle}" />
                                <StackPanel x:Name="EngineList" Spacing="10" />
                                <Button x:Name="RetryButton" Content="Retry" Click="OnRetry" HorizontalAlignment="Left" ToolTipService.ToolTip="Check the color engines again" />
                                <Rectangle Height="1" Fill="{ThemeResource NoxelDivider}" />
                                <TextBlock Style="{StaticResource FaintText}" Text="The color matrix is applied by Windows' compositor (like Windows color filters): it affects the desktop, windowed and borderless games, but not exclusive-fullscreen games, protected video or HDR. While it's active Windows composes every frame, which can add up to one frame of latency. Digital vibrance is applied by the NVIDIA driver and also works in exclusive fullscreen." />
                                <TextBlock Style="{StaticResource FaintText}" Text="NOXEL never injects into games or installs drivers. Closing NOXEL (Exit) restores your original colors." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>
