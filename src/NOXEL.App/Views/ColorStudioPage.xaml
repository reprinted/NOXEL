<Page
    x:Class="Noxel.App.Views.ColorStudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1180" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SideCol.Width" Value="0" />
                        <Setter Target="SidePanel.(Grid.Column)" Value="0" />
                        <Setter Target="SidePanel.(Grid.Row)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer>
            <StackPanel Padding="28,6,28,28" Spacing="16" MaxWidth="1320">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Color Studio" Style="{StaticResource PageTitle}" />
                        <TextBlock x:Name="Subtitle" Text="Adjust your display colors. Changes apply to all displays." Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="AppliedText" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="MasterSwitch" OnContent="Effects on" OffContent="Effects off" Toggled="OnMasterToggled" AutomationProperties.Name="Color effects" />
                    </StackPanel>
                </Grid>

                <InfoBar x:Name="HdrBar" Severity="Warning" IsClosable="False" Title="HDR is on"
                         Message="Windows ignores color matrices and gamma ramps for HDR output. Turn HDR off in Windows display settings to use those controls." />

                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="SideCol" Width="340" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource GlassCard}" VerticalAlignment="Top" Padding="20,18">
                        <StackPanel Spacing="4">
                            <Grid Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock x:Name="LookName" Text="Custom look" Style="{StaticResource CardTitle}" FontSize="18" />
                                    <TextBlock x:Name="LookSummary" Style="{StaticResource FaintText}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="LiveSwitch" HorizontalAlignment="Right" OnContent="Live preview" OffContent="Live preview" Toggled="OnLiveToggled"
                                              AutomationProperties.Name="Live preview" ToolTipService.ToolTip="Apply changes while you drag" />
                            </Grid>
                            <StackPanel x:Name="Rows" Spacing="6" />
                            <TextBlock Style="{StaticResource FaintText}" Margin="0,8,0,0"
                                       Text="Type a value and press Enter for an exact setting. Double-click a slider to reset it." />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="SidePanel" Grid.Column="1" Spacing="16">
                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Actions" Style="{StaticResource CardTitle}" />
                                <Button x:Name="ApplyButton" Content="Apply look" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="OnApply" />
                                <ToggleButton x:Name="CompareButton" HorizontalAlignment="Stretch" Checked="OnCompare" Unchecked="OnCompare"
                                              Content="Compare with original" AutomationProperties.Name="Compare with original colors" />
                                <Button Content="Save as preset…" HorizontalAlignment="Stretch" Click="OnSave" />
                                <Button x:Name="UpdatePresetButton" HorizontalAlignment="Stretch" Click="OnUpdatePreset" />
                                <Button Content="Reset all sliders" HorizontalAlignment="Stretch" Click="OnResetAll" />
                                <Button Content="Restore original colors" HorizontalAlignment="Stretch" Click="OnRestore"
                                        ToolTipService.ToolTip="Turns every effect off and restores the colors Windows had before NOXEL." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="How each control works" Style="{StaticResource CardTitle}" />
                                <StackPanel x:Name="EngineList" Spacing="10" />
                                <Button x:Name="RetryButton" Content="Retry" Click="OnRetry" HorizontalAlignment="Left" ToolTipService.ToolTip="Check the color engines again" />
                                <Rectangle Height="1" Fill="{ThemeResource NoxelDivider}" />
                                <TextBlock Style="{StaticResource FaintText}" Text="The color matrix is applied by Windows' compositor (like Windows color filters): it affects the desktop, windowed and borderless games, but not exclusive-fullscreen games, protected video or HDR. While it's active Windows composes every frame, which can add up to one frame of latency. Digital vibrance is applied by the NVIDIA driver and also works in exclusive fullscreen." />
                                <TextBlock Style="{StaticResource FaintText}" Text="NOXEL never injects into games or installs drivers. Closing NOXEL (Exit) restores your original colors." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
